{
  "version": 1,
  "settings": {
    "version_count": 5,
    "retention_days": 30,
    "offline_after_secs": 60
  },
  "devices": [
    { "name": "laptop", "token_hash": "<sha256 of the device token, in hex>" },
    { "name": "desktop", "token": "a-token-you-chose" },
    { "name": "photos", "kind": "local" }
  ],
  "mirrors": [
    {
      "name": "offsite",
      "remote_type": "s3",
      "remote_path": "my-bucket/fafnirx",
      "options": { "provider": "AWS", "region": "eu-west-1", "access_key_id": "...", "secret_access_key": "..." },
      "interval_hours": 72,
      "keep_runs": 3
    },
    {
      "name": "vault",
      "remote": "b2crypt:fafnirx",
      "interval_hours": 24,
      "keep_runs": 10
    }
  ],
  "sources": [
    {
      "name": "drive",
      "folders": ["<Drive folder id or folder URL>"],
      "service_account": { "client_email": "sa@project.iam.gserviceaccount.com", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" },
      "interval_hours": 24
    }
  ]
}
