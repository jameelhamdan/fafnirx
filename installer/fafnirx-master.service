# systemd unit for running the master without Docker (PostgreSQL must already be reachable).
#   sudo cp installer/fafnirx-master.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fafnirx-master
# Put the secrets in /etc/fafnirx/master.env (mode 0600):
#   FAFNIRX_DATABASE_URL=postgresql://fafnirx:password@localhost/fafnirx
#   FAFNIRX_ADMIN_PASSWORD=choose-one
#   FAFNIRX_DATA=/tank/fafnirx/data
[Unit]
Description=fafnirx master
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=fafnirx
EnvironmentFile=/etc/fafnirx/master.env
ExecStart=/usr/local/bin/fafnirx-master
Restart=always
RestartSec=5
# rclone (mirrors) wants a writable home for its cache
Environment=HOME=/var/lib/fafnirx
StateDirectory=fafnirx

[Install]
WantedBy=multi-user.target
