# Copy to .env and change the passwords. docker compose reads it.
FAFNIRX_ADMIN_PASSWORD=change-me
FAFNIRX_DB_PASSWORD=change-me-too

# Where things live on the host (defaults: ./data and ./pgdata next to docker-compose.yml, in this folder)
#FAFNIRX_DATA_DIR=/tank/fafnirx/data   # files, versions, updates; share files/ as a network drive
#FAFNIRX_DB_DIR=/tank/fafnirx/pgdata   # PostgreSQL files: local disk, never SMB or NFS
#FAFNIRX_UID=1000                      # owner of the files in the data dir
#FAFNIRX_GID=1000
#FAFNIRX_CONFIG_DIR=/tank/fafnirx/config  # rclone.conf, if mirrors use rclone remotes

# Add-ons (docs/modules.md): containers you start with a profile; they connect to the master by themselves with this secret
# (16+ characters, `openssl rand -hex 24`), which the master and the add-ons share. Video playback (docs/video.md), web sources (docs/fetch.md):
#FAFNIRX_PLUGIN_SECRET=generate-with-openssl-rand-hex-24
#COMPOSE_PROFILES=video,fetch
#FAFNIRX_PLUGINS=video,fetch           # optional: the add-ons that must be running (default: COMPOSE_PROFILES); one missing or broken shows administrators a big warning
#FAFNIRX_VIDEO_CACHE_DIR=./video-cache
#FAFNIRX_VIDEO_IMAGE=jameelh99/fafnirx-video:3.0.1

# The image: "latest" release on Docker Hub by default. Pin a version to upgrade on purpose (docker compose pull && docker compose up -d)
#FAFNIRX_IMAGE=jameelh99/fafnirx:3.0.1

# A reverse proxy (Caddy) in front, with the master's own ports closed: docs/deployment.md
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
#FAFNIRX_WEB_ADDRESS=fafnirx.example.com
#FAFNIRX_DEVICE_ADDRESS=fafnirx.example.com:7443

# Sizes for the machine (docs/deployment.md#sizing-and-tuning). Defaults suit 2-4 cores; a Raspberry Pi: DB_POOL=4, JOB_WORKERS=1-2
#FAFNIRX_DB_POOL=8
#FAFNIRX_JOB_WORKERS=4
#FAFNIRX_STREAMS=32
