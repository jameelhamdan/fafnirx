# The video module (HLS streaming, subtitles, video details), a container that connects to the master by itself (docs/modules.md).
# Build from the repository root:  docker build -f docker/Dockerfile.video -t fafnirx-video .

FROM node:22-bookworm-slim AS web
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build:module -- video

FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY modules modules
COPY proto proto
RUN cargo build --release -p fafnirx-video

FROM debian:bookworm-slim
# ffmpeg (with ffprobe) cuts the segments, reads the videos and draws their poster frames; curl is for the health check.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home fafnirx \
    && mkdir /data /cache && chown fafnirx /data /cache
COPY --from=build /src/target/release/fafnirx-video /usr/local/bin/fafnirx-video
COPY --from=web /src/frontend/dist-modules/video /usr/share/fafnirx-video/ui
ENV FAFNIRX_DATA=/data FAFNIRX_VIDEO_CACHE=/cache FAFNIRX_PLUGIN_LISTEN=0.0.0.0:8090 FAFNIRX_PLUGIN_UI=/usr/share/fafnirx-video/ui
VOLUME /cache
EXPOSE 8090
USER fafnirx
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${FAFNIRX_PLUGIN_LISTEN##*:}/health" || exit 1
CMD ["fafnirx-video"]
