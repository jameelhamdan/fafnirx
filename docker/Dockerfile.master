# The master: the Rust binary with the web app built into it, and rclone for mirrors. No ffmpeg, so it is small.
# Build from the repository root:  docker build -f docker/Dockerfile.master -t fafnirx .
# Modules have a Dockerfile each (Dockerfile.video, Dockerfile.fetch).

FROM node:22-bookworm-slim AS web
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM rust:1-bookworm AS build
# The typed queries (crates/db) are made while building, from the SQL and the migrations, and checked against a real
# PostgreSQL. One runs in this stage, for the length of the build only; it is not part of the image.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY modules modules
COPY queries queries
COPY proto proto
COPY --from=web /src/frontend/dist frontend/dist
RUN service postgresql start \
    && until pg_isready -h localhost -q; do sleep 1; done \
    && su postgres -c "psql -qc \"ALTER USER postgres PASSWORD 'build'\"" \
    && FAFNIRX_CODEGEN_DATABASE_URL=postgresql://postgres:build@localhost:5432 \
       cargo build --release -p fafnirx-master \
    && service postgresql stop

FROM debian:bookworm-slim
# rclone performs the mirror uploads and reads storage sources: the upstream release, pinned and checked against the checksums
# below (Debian's package is years older). ca-certificates lets it (and the master) verify remote TLS; curl is for the download
# and the health check.
ARG RCLONE_VERSION=1.75.2
ARG RCLONE_SHA256_AMD64=349ac8fba6ff65d6247043f1750cdcb518ec5d500ef91463a10d37c0ccdf3702
ARG RCLONE_SHA256_ARM64=7e1e8d69654941b7b7df84ee74c5f7fb09cce7d5496947fb7bf16b55ff427d10
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "$arch" in amd64) sum=$RCLONE_SHA256_AMD64 ;; arm64) sum=$RCLONE_SHA256_ARM64 ;; *) echo "no rclone for $arch" >&2; exit 1 ;; esac \
    && curl -fsSLo /tmp/rclone.zip "https://downloads.rclone.org/v$RCLONE_VERSION/rclone-v$RCLONE_VERSION-linux-$arch.zip" \
    && echo "$sum  /tmp/rclone.zip" | sha256sum -c - \
    && unzip -qj /tmp/rclone.zip "*/rclone" -d /usr/local/bin \
    && chmod 755 /usr/local/bin/rclone \
    && rm /tmp/rclone.zip \
    && apt-get purge -y unzip && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home fafnirx \
    && mkdir /data /config && chown fafnirx /data /config
COPY --from=build /src/target/release/fafnirx-master /usr/local/bin/fafnirx-master
# /config holds rclone.conf, if you use one for mirrors. Map a host folder onto it.
ENV FAFNIRX_DATA=/data FAFNIRX_RCLONE_CONFIG=/config/rclone.conf FAFNIRX_HTTP=0.0.0.0:8080
VOLUME /data /config
EXPOSE 7443 8080
USER fafnirx
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${FAFNIRX_HTTP##*:}/healthz" || exit 1
CMD ["fafnirx-master"]
